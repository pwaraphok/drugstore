   {tab==='purchasing'&&<><div className="toolbar"><p className="muted">รับสินค้าเป็นล็อต พร้อมต้นทุนและหลักฐานผู้จำหน่าย</p><button className="primary" disabled={busy} onClick={()=>openForm('รับสินค้าเข้าคลัง',[{name:'productId',label:'สินค้า',type:'select',options:options(products,'tradeName'),required:true},{name:'supplierId',label:'ผู้จำหน่าย',type:'select',options:options(lookups.suppliers,'name'),required:true},{name:'locationId',label:'ตำแหน่งเก็บ',type:'select',options:options(lookups.locations,'code'),required:true},{name:'supplierDocument',label:'เลขเอกสารผู้จำหน่าย',required:true},{name:'lotNumber',label:'เลขล็อต',required:true},{name:'quantity',label:'จำนวนหน่วยฐาน',type:'number',required:true},{name:'unitCost',label:'ต้นทุนต่อหน่วยฐาน',type:'number',required:true},{name:'expiryRaw',label:'วันหมดอายุตามฉลาก',type:'date',required:true},{name:'usableUntilExclusive',label:'วันแรกที่ห้ามขาย (ตามนโยบายที่ร้านยืนยัน)',type:'date',required:true},{name:'condition',label:'ผลตรวจรับ',type:'select',options:[{value:'quarantine',label:'รับเข้ากักกัน'},{value:'passed',label:'ตรวจรับผ่านและอนุญาตขาย'}]},{name:'reasonNoPo',label:'เหตุผลรับโดยไม่มีใบสั่งซื้อ',required:true}],async b=>{const p=await api('/products/'+b.productId);const pkg=p.packages.find((x:Row)=>Number(x.baseQuantity)===1);if(!pkg)throw new Error('สินค้าไม่มีหน่วยฐานที่รับได้');const key='receipt-'+crypto.randomUUID();await api('/purchase-orders/receive',{supplierId:b.supplierId,supplierDocument:b.supplierDocument,reasonNoPo:b.reasonNoPo,items:[{productId:b.productId,packageId:String(pkg.id),locationId:b.locationId,quantity:b.quantity,unitCost:b.unitCost,lotNumber:b.lotNumber,expiryRaw:b.expiryRaw,expiryPrecision:'DAY',usableUntilExclusive:b.usableUntilExclusive,inspectPassed:b.condition==='passed'}]},key);setModal(null);await refresh();setNotice('รับสินค้าและบันทึกต้นทุนแล้ว');})}><Plus size={17}/> รับสินค้าเข้า</button></div><section className="panel"><PanelHead title="เอกสารรับเข้าล่าสุด" subtitle="รายการที่ลงสต็อกแล้ว"/><Table heads={['เลขที่','วันที่รับ','เอกสารผู้จำหน่าย','เหตุผล / อ้างอิง','สถานะ']} rows={receipts.map(r=>[r.id,date(r.receivedAt),r.supplierDocument||'—',r.reasonNoPo||'ใบสั่งซื้อ '+r.purchaseOrderId,<Badge key="s" value={r.status}/>])}/></section><section className="panel spaced"><PanelHead title="ใบสั่งซื้อ" subtitle="ใบสั่งซื้อจากระบบกลาง"/><Table heads={['เลขที่','ผู้จำหน่าย','วันที่','สถานะ']} rows={orders.map(o=>[o.id,lookups.suppliers.find((s:Row)=>s.id===o.supplierId)?.name||o.supplierId,date(o.createdAt),<Badge key="s" value={o.status}/>])}/></section></>}
   {tab==='patients'&&<><div className="toolbar"><div className="searchbar"><Search size={18}/><input placeholder="ค้นหาชื่อ / เลขประจำตัว" value={search} onChange={e=>setSearch(e.target.value)}/></div><button className="primary" onClick={()=>openForm('เพิ่มผู้รับบริการ',[{name:'name',label:'ชื่อผู้รับบริการ',required:true},{name:'birthDate',label:'วันเกิด',type:'date'},{name:'contact',label:'ข้อมูลติดต่อ (เมื่อจำเป็น)'}],async b=>{await api('/patients',{...b,birthDate:b.birthDate||undefined});await refresh();setModal(null);})}><Plus size={17}/> เพิ่มผู้รับบริการ</button></div><section className="panel"><Table heads={['เลขประจำตัว','ชื่อ','วันเกิด','ประวัติแพ้ยา','ข้อมูล']} rows={patients.filter(p=>(p.name+p.patientNumber).includes(search)).map(p=>[p.patientNumber,p.name,date(p.birthDate),<Badge key="s" value={p.allergyStatus}/>,<button key="v" className="text-button" disabled={busy} onClick={()=>run(async()=>setPatientDetail(await api('/patients/'+p.id)))}>เปิดประวัติ <ArrowUpRight size={14}/></button>])}/></section>{patientDetail&&<section className="panel spaced"><PanelHead title={patientDetail.patient.name} subtitle={patientDetail.patient.patientNumber}/><div className="panel-body"><div className="inline-actions"><button className="secondary" onClick={()=>openForm('ยืนยันสถานะประวัติแพ้ยา',[{name:'allergyStatus',label:'สถานะที่ซักประวัติแล้ว',type:'select',options:['UNKNOWN','NOT_ASKED','NO_KNOWN_ALLERGIES','KNOWN_ALLERGIES'].map(s=>({value:s,label:status[s]}))}],async b=>{await api(`/operations/patients/${patientDetail.patient.id}/history`,b);setPatientDetail(await api('/patients/'+patientDetail.patient.id));await refresh();setModal(null);})}>ยืนยันประวัติ</button><button className="secondary" onClick={()=>openForm('บันทึกแพ้ยา',[{name:'ingredientId',label:'สารสำคัญ (ถ้าจับคู่ได้)',type:'select',options:[{value:'',label:'ยังจับคู่ไม่ได้'},...options(lookups.ingredients,'preferredName')]},{name:'rawName',label:'ชื่อยาที่ผู้ป่วยแจ้ง',required:true},{name:'reaction',label:'อาการที่รายงาน',required:true},{name:'severity',label:'ความรุนแรง',type:'select',options:['MILD','MODERATE','SEVERE'].map(s=>({value:s,label:s}))}],async b=>{await api(`/patients/${patientDetail.patient.id}/allergies`,{...b,ingredientId:b.ingredientId||undefined,targetType:b.ingredientId?'INGREDIENT':'RAW'});setPatientDetail(await api('/patients/'+patientDetail.patient.id));await refresh();setModal(null);})}>เพิ่มประวัติแพ้ยา</button><button className="secondary" onClick={()=>openForm('บันทึกยาที่ใช้อยู่',[{name:'productId',label:'ยาในระบบ',type:'select',options:[{value:'',label:'ระบุชื่อเอง'},...options(products,'tradeName')]},{name:'rawName',label:'ชื่อยาที่แจ้ง'},{name:'doseText',label:'วิธีใช้ที่แจ้ง'}],async b=>{await api(`/operations/patients/${patientDetail.patient.id}/medications`,{...b,productId:b.productId||undefined});setPatientDetail(await api('/patients/'+patientDetail.patient.id));setModal(null);})}>เพิ่มยาที่ใช้อยู่</button><button className="secondary" onClick={()=>openForm('บันทึกการให้บริการ',[{name:'complaint',label:'อาการสำคัญ',type:'textarea'},{name:'assessmentNote',label:'การประเมิน',type:'textarea',required:true},{name:'counselingNote',label:'คำแนะนำ',type:'textarea'},{name:'referralNote',label:'การส่งต่อ',type:'textarea'}],async b=>{await api(`/patients/${patientDetail.patient.id}/encounters`,b);setPatientDetail(await api('/patients/'+patientDetail.patient.id));setModal(null);})}>บันทึกให้บริการ</button></div><h3>ประวัติแพ้ยา</h3><Table heads={['ชื่อที่แจ้ง','อาการ','ความรุนแรง','การจับคู่']} rows={patientDetail.allergies.map((a:Row)=>[a.rawName||a.ingredientId,a.reaction,a.severity,a.verificationStatus])}/><h3>ยาที่ใช้อยู่</h3><Table heads={['ชื่อยา / รหัส','วิธีใช้']} rows={patientDetail.medications.map((m:Row)=>[m.rawName||products.find(p=>p.id===m.productId)?.tradeName||m.ingredientId,m.doseText])}/><h3>การให้บริการ</h3><Table heads={['วันที่','อาการ','ประเมิน','คำแนะนำ']} rows={patientDetail.encounters.map((e:Row)=>[date(e.occurredAt),e.complaint,e.assessmentNote,e.counselingNote])}/></div></section>}</>}
   {tab==='sales'&&<><section className="panel"><PanelHead title="ประวัติรายการขาย" subtitle="แสดง 100 บิลล่าสุด • เปิดบิลเพื่อทำต่อหรือคืนสินค้า"/><SaleTable rows={sales} onSelect={id=>run(()=>inspectSale(id))}/></section>{saleDetail&&<section className="panel spaced"><PanelHead title={saleDetail.sale.invoiceNumber} subtitle={date(saleDetail.sale.createdAt)}/><div className="panel-body"><Badge value={saleDetail.sale.status}/><Table heads={['สินค้า','จำนวน','ยอด']} rows={saleDetail.items.map((i:Row)=>[i.productSnapshot.tradeName,Number(i.quantity),'฿'+baht(i.lineTotal)])}/><h3>ยอดรวม ฿{baht(saleDetail.sale.grandTotal)}</h3><div className="inline-actions">{saleDetail.sale.status!=='COMPLETED'&&<button className="primary" onClick={()=>{setCart(saleDetail);setPatientId(saleDetail.sale.patientId||'');setTab('pos');}}>เปิดบิลนี้ต่อ</button>}{saleDetail.sale.status==='COMPLETED'&&<button className="secondary" onClick={()=>showReceipt(saleDetail)}><Printer size={16}/> ใบเสร็จ</button>}{saleDetail.allocations.length>0&&<button className="secondary" onClick={()=>openForm('รับคืนสินค้าเข้ากักกัน',[{name:'originalAllocationId',label:'รายการ / ล็อต',type:'select',options:saleDetail.allocations.map((a:Row)=>({value:a.id,label:`สินค้า ${a.productId} • ล็อต ${a.lotId} • จ่าย ${Number(a.quantityBase)}`})),required:true},{name:'quantity',label:'จำนวนหน่วยฐานที่คืน',type:'number',required:true},{name:'quarantineLocationId',label:'ตำแหน่งกักกัน',type:'select',options:options(lookups.locations.filter((l:Row)=>l.locationType==='QUARANTINE'),'code'),required:true}],async b=>{await api('/returns',{originalSaleId:saleDetail.sale.id,quarantineLocationId:b.quarantineLocationId,items:[{originalAllocationId:b.originalAllocationId,quantity:b.quantity}]},crypto.randomUUID());await refresh();setModal(null);setNotice('รับเข้ากักกันแล้ว การคืนเงินเป็นขั้นตอนแยก');})}>รับคืนสินค้า</button>}{saleDetail.payments.length>0&&<button className="secondary" onClick={()=>{const key=crypto.randomUUID();openForm('คืนเงินสด',[{name:'originalPaymentId',label:'รายการรับเงิน',type:'select',options:saleDetail.payments.filter((p:Row)=>p.status==='SUCCEEDED').map((p:Row)=>({value:p.id,label:`#${p.id} • ฿${baht(p.appliedAmount)}`})),required:true},{name:'amount',label:'ยอดคืน (บาท)',type:'number',required:true},{name:'reason',label:'เหตุผล',type:'textarea',required:true}],async b=>{await api('/refunds',b,key);await refresh();setModal(null);setNotice('บันทึกคืนเงินสดแล้ว');});}}>คืนเงิน</button>}</div></div></section>}</>}
   {tab==='reports'&&<><div className="stats"><Stat title="บิลรับเงินแล้วรอส่งมอบ" value={String(recon.paidUnfulfilled.length)} detail="ตรวจสอบและเปิดบิลทำต่อ" icon={<ReceiptText/>}/><Stat title="ยอดสต็อกไม่ตรงบัญชี" value={String(recon.stockMismatch.length)} detail="ควรเป็นศูนย์ก่อนปิดร้าน" icon={<Boxes/>}/><Stat title="งานพิมพ์" value={String(prints.length)} detail="แสดงล่าสุด 50 งาน" icon={<Printer/>}/><Stat title="สินค้ารับคืน" value={String(returns.length)} detail="รับเข้ากักกันก่อนทุกครั้ง" icon={<Package/>}/></div><section className="panel"><PanelHead title="งานฉลากยา" subtitle="การเปิดหน้าต่างพิมพ์ยังไม่ถือว่ากระดาษออกแล้ว"/><Table heads={['งาน','บิล','สถานะ','จัดการ']} rows={prints.map(p=>[p.id,p.documentId,<Badge key="s" value={p.state}/>,<div className="inline-actions" key="a"><button className="text-button" onClick={()=>{const w=window.open('','_blank');if(w){w.document.write('<html lang="th"><head><title>ฉลากยา</title><style>body{font:14px sans-serif}.label{box-sizing:border-box;break-after:page;overflow-wrap:anywhere}@media print{button{display:none}}</style></head><body>'+p.htmlSnapshot+'<button onclick="window.print()">พิมพ์ฉลาก</button></body></html>');w.document.close();}}}>เปิดฉลาก</button><button className="text-button" disabled={busy||p.state==='CONFIRMED'} onClick={()=>run(async()=>{await api(`/print-jobs/${p.id}/state`,{state:'CONFIRMED'});await refresh();})}>ยืนยันกระดาษออก</button></div>])}/></section><section className="panel spaced"><PanelHead title="รายการที่รับเงินแล้วรอส่งมอบ" subtitle="ไม่รับเงินซ้ำ ให้เปิดบิลตรวจสอบ"/><Table heads={['บิล','สถานะ','ยอดรับ','เปิด']} rows={recon.paidUnfulfilled.map((s:Row)=>[s.invoice_number,<Badge key="s" value={s.status}/>,baht(s.paid),<button key="a" className="text-button" onClick={()=>run(async()=>{setCart(await api('/sales/'+s.id));setTab('pos');})}>เปิดบิล</button>])}/></section><section className="panel spaced"><PanelHead title="รายงานกำกับและ GPP" subtitle="ต้องตรวจ mapping และแบบฟอร์มก่อนใช้เป็นเอกสารทางการ"/><div className="panel-body"><div className="alert warning"><ShieldCheck size={19}/> ยังไม่เปิดส่งออกรายงานทางการ จนกว่าจะยืนยันรายการยา กฎ และแม่แบบที่ใช้กับร้านนี้</div><p className="muted">ข.ย.9 บัญชีซื้อ • ข.ย.10 ยาควบคุมพิเศษ • ข.ย.11 ยาอันตรายเฉพาะรายการ • ข.ย.12 ตามใบสั่งยา</p></div></section><section className="panel spaced"><PanelHead title="ประวัติการดำเนินการ" subtitle="ล่าสุด 200 รายการ"/><Table heads={['วันที่','การกระทำ','ชนิด','เลขอ้างอิง','ผู้ทำ']} rows={audit.slice(0,30).map(a=>[date(a.createdAt),a.action,a.entityType,a.entityId,a.actorId])}/></section></>}
   {tab==='settings'&&<div className="two-col"><section className="panel"><PanelHead title="กะและผู้ปฏิบัติการ" subtitle="แยกกะเงินสดจากกะเภสัชกร"/><div className="panel-body"><p>กะเงินสด: <b>{lookups.cashShift?'เปิดอยู่':'ยังไม่เปิด'}</b></p><p>กะเภสัชกร: <b>{user.activeShiftId?'กำลังปฏิบัติการ':'ยังไม่เปิด'}</b></p><div className="inline-actions">{lookups.cashShift&&<button className="secondary" onClick={()=>openForm('ปิดกะเงินสด',[{name:'countedCash',label:'เงินสดที่นับจริง',type:'number',required:true},{name:'reason',label:'เหตุผลกรณียอดต่าง',type:'textarea'}],async b=>{const shift=await api('/sales/cash-shifts/close',b);await refresh();setModal(null);setNotice(`ปิดกะแล้ว คาดหมาย ฿${baht(shift.expectedCash)} • ส่วนต่าง ฿${baht(shift.variance)}`);})}>นับเงินและปิดกะ</button>}{user.activeShiftId&&<button className="secondary" disabled={busy} onClick={()=>run(async()=>{await api('/pharmacist-shifts/end',{});await refresh();})}>สิ้นสุดปฏิบัติการ</button>}</div><h3>สถานะการเชื่อมต่อ</h3><p className="muted">ฐานข้อมูล: MariaDB ในเครื่อง<br/>ชำระเงิน: เงินสด<br/>ข้อมูลคลินิก: ต้องให้เภสัชกรทบทวน<br/>พิมพ์: ผ่านเบราว์เซอร์</p></div></section><section className="panel"><PanelHead title="ข้อมูลตั้งต้นร้าน" subtitle="เพิ่มข้อมูลที่ใช้ร่วมกัน"/><div className="panel-body settings-actions"><button className="secondary" onClick={()=>openForm('เพิ่มผู้จำหน่าย',[{name:'name',label:'ชื่อ',required:true},{name:'contact',label:'ติดต่อ'},{name:'address',label:'ที่อยู่',type:'textarea'}],async b=>{await api('/operations/suppliers',b);await refresh();setModal(null);})}><Truck size={18}/> ผู้จำหน่ายใหม่</button><button className="secondary" onClick={()=>openForm('เพิ่มหน่วยสินค้า',[{name:'code',label:'รหัสหน่วย',required:true},{name:'displayName',label:'ชื่อหน่วย',required:true}],async b=>{await api('/operations/units',b);await refresh();setModal(null);})}><Boxes size={18}/> หน่วยสินค้าใหม่</button><button className="secondary" onClick={()=>openForm('เพิ่มสารสำคัญ',[{name:'code',label:'รหัสสารสำคัญ',required:true},{name:'preferredName',label:'ชื่อมาตรฐานที่ตรวจสอบแล้ว',required:true}],async b=>{await api('/operations/ingredients',b);await refresh();setModal(null);})}><Pill size={18}/> สารสำคัญใหม่</button><button className="secondary" onClick={()=>openForm('เพิ่มบรรจุภัณฑ์ / หน่วยขาย',[{name:'productId',label:'สินค้า',type:'select',options:options(products,'tradeName'),required:true},{name:'unitId',label:'หน่วย',type:'select',options:options(lookups.units,'displayName'),required:true},{name:'baseQuantity',label:'จำนวนหน่วยฐานต่อบรรจุภัณฑ์',type:'number',required:true},{name:'price',label:'ราคาขาย',type:'number',required:true},{name:'barcode',label:'บาร์โค้ด'}],async b=>{await api('/operations/packages',b);await refresh();setModal(null);})}><Package size={18}/> บรรจุภัณฑ์ใหม่</button></div></section></div>}
   <footer>เภสัชพร้อม <span>ข้อมูลสาธิตสำหรับทดสอบ • ต้องตรวจรับก่อนใช้กับผู้ป่วยจริง</span></footer>
   </section>
  </main>
  {modal&&<div className="modal-backdrop"><form className="modal" onSubmit={e=>{e.preventDefault();const body=Object.fromEntries(new FormData(e.currentTarget));run(()=>modal.submit(body));}}><div className="modal-head"><div><span className="eyebrow">บันทึกข้อมูล</span><h2>{modal.title}</h2>{modal.description&&<p className="muted">{modal.description}</p>}</div><button type="button" className="icon-button" aria-label="ปิดหน้าต่าง" disabled={busy} onClick={()=>setModal(null)}><X/></button></div><div className="form-fields">{modal.fields.map(f=><label key={f.name}>{f.label}{f.required&&<span className="required"> *</span>}{f.type==='select'?<select name={f.name} required={f.required} defaultValue={f.value??f.options?.[0]?.value}>{f.options?.map(o=><option key={o.value} value={o.value}>{o.label}</option>)}</select>:f.type==='textarea'?<textarea name={f.name} required={f.required} defaultValue={f.value} rows={3}/>:<input name={f.name} type={f.type||'text'} step={f.type==='number'?'any':undefined} min={f.type==='number'?'0':undefined} required={f.required} defaultValue={f.value}/>}</label>)}</div>{error&&<div className="alert error" role="alert">{error}</div>}<div className="modal-actions"><button type="button" className="secondary" disabled={busy} onClick={()=>setModal(null)}>ยกเลิก</button><button className="primary" disabled={busy}>{busy?'กำลังบันทึก…':'บันทึกข้อมูล'}<Check size={17}/></button></div></form></div>}
 </div>;
}
function Stat({title,value,detail,icon}:{title:string;value:string;detail:string;icon:React.ReactNode}){return <div className="stat"><div><span>{title}</span><span className="stat-icon">{icon}</span></div><strong>{value}</strong><small>{detail}</small></div>}
function Empty({text='ยังไม่มีรายการ'}:{text?:string}){return <div className="empty"><Package size={29}/><p>{text}</p></div>}
function PanelHead({title,subtitle,action}:{title:string;subtitle?:string;action?:()=>void}){return <div className="panel-head"><div><h2>{title}</h2>{subtitle&&<p>{subtitle}</p>}</div>{action&&<button className="text-button" onClick={action}>ดูทั้งหมด <ArrowUpRight size={15}/></button>}</div>}
function Table({heads,rows}:{heads:string[];rows:React.ReactNode[][]}){return rows.length?<div className="table-wrap"><table><thead><tr>{heads.map(h=><th key={h}>{h}</th>)}</tr></thead><tbody>{rows.map((row,i)=><tr key={i}>{row.map((cell,j)=><td key={j}>{cell??'—'}</td>)}</tr>)}</tbody></table></div>:<Empty/>}
function SaleTable({rows,onSelect}:{rows:Row[];onSelect:(id:string)=>void}){return <Table heads={['เลขที่บิล','วันที่','ยอดรวม','สถานะ','']} rows={rows.map(s=>[<span className="invoice" key="i">{s.invoiceNumber}</span>,date(s.createdAt),'฿'+baht(s.grandTotal),<Badge key="s" value={s.status}/>,<button key="b" className="icon-button" aria-label={'เปิดบิล '+s.invoiceNumber} onClick={()=>onSelect(s.id)}><ArrowUpRight size={18}/></button>])}/>}
